# Variáveis públicas do app (EXPO_PUBLIC_* entram no bundle: nunca coloque segredo aqui).
# Copie para .env e preencha. O .env NÃO é versionado.

# URL do projeto Supabase. Local: rode `make db-up` e use a "API URL" (http://127.0.0.1:54321);
# no celular com Expo Go, troque 127.0.0.1 pelo IP do seu computador na rede (ex.: http://192.168.0.10:54321).
# Nuvem: Supabase → Project Settings → API → Project URL.
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública (anon / publishable). Local: "anon key" impressa por `make db-up`.
# Nuvem: Supabase → Project Settings → API → anon public.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Só no CI (preview.yml): EXPO_GO_PREVIEW=true troca o runtimeVersion para "exposdk:<SDK>",
# o único que o Expo Go abre. Não defina localmente.

# Só em desenvolvimento: mostra o botão "Entrar como teste" (Maestro, .maestro/login.yaml), que
# entra com o usuário de supabase/dev/usuario-teste.sql (só existe no Supabase LOCAL; `make db-reset`).
# Não tem efeito em builds e EAS Updates de preview/produção (__DEV__ = false). Nunca defina no EAS
# nem nos secrets do GitHub.
# EXPO_PUBLIC_DEV_LOGIN=true
